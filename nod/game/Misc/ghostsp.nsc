// ****************************************************************************
//
// GHOST SINGLE PLAYER CHRONICLE FILE
//
//
// This file lists all the single player missions in the game in order.
// It also allows setting up various data about the mission, like player vital
// stats, available powers, calldowns, inventory, etc.
//
// ----------------------------------------------------------------------------
//
// Format:
//
// MISSION 		nlsName initialLevel [masterScript]
// LOADSCREEN	screenName
// OBJECTIVE	nlsName flags
// STATS		health psipool
// AMMO     maxgauss maxsnipe maxpistol maxflamethrower
// PSIBLADE		0 | 1
// POWERS		[cloak] [speed] [sight] [shield] [storm]
// SIGHTFLAGS	footprint interactive burrowed critical cloaked threat
// CALLDOWNS	[identify] [comsat] [irradiate] [emp] [arclite] [yamato] [nuke] [lockdown]
// INVENTORY	item	quantity
// ENDMISSION
//
// maxGauss 200
// maxSnipe 50
// maxPistol 150
// maxFlame 1000
//
// Inventory items:  canister
//                   firefly
//                   smokegrenade CUT
//                   stasisgrenade CUT
//                   stickygrenade CUT
//                   concussiongrenade CUT
//                   empgrenade CUT
//                   irradiategrenade CUT
//                   flamethrower
//                   spidermine
//                   (health)
//                   (lockdown)
//
// Notes:
// 1) nlsName is a reference to the NLS file (display string)
// 2) OBJECTIVE and INVENTORY can (and should :)) be repeated multiple times
// 3) Powers and Calldowns can be listed in any order, gaps are allowed
// 4) more keywords will be added to manage pre and post prerendered cutscenes
//
// ****************************************************************************

// IDENTIFICATION 
// Specifies which slot this chronicle saves its data in, and what game type this chronicle is designed for
//

PROFILEID		0
GAMETYPE		   0

// MISSIONS
//

MISSION        1_0_0_TR_DEF  1_0_0_TR_Defaults
OBJECTIVE      1_0_0_O00 1
OBJECTIVE      1_0_0_O01 1
OBJECTIVE      1_0_0_O02 1
OBJECTIVE      1_0_0_O03 1
OBJECTIVE      1_0_0_O04 1
OBJECTIVE      1_0_0_O05 1
OBJECTIVE      1_0_0_O06 1
LOADSCREEN     111a_MenuImage
LOADTEXT       1_0_0_TR_Defaults.nlt
STATS          100 100 0
AMMO           100 25 75
POWERS         cloak
SIGHTFLAGS     footprint
CALLDOWNS      identify
INVENTORY      canister 3
ENDMISSION

